<Window x:Class="CampusApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CampusApp"
        mc:Ignorable="d"
        Title="Sistem Manajemen Data Mahasiswa (WPF MVVM)"
        Height="780" Width="1200"
        MinHeight="650" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- PALET WARNA -->
        <SolidColorBrush x:Key="PrimaryBlue" Color="#2563EB"/>
        <SolidColorBrush x:Key="PrimaryHover" Color="#1D4ED8"/>
        <SolidColorBrush x:Key="DarkNavy" Color="#0F172A"/>
        <SolidColorBrush x:Key="TextDark" Color="#1E293B"/>
        <SolidColorBrush x:Key="TextMuted" Color="#64748B"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SuccessGreen" Color="#10B981"/>
        <SolidColorBrush x:Key="DangerRed" Color="#EF4444"/>
        <SolidColorBrush x:Key="WarningOrange" Color="#F59E0B"/>

        <!-- GAYA TEXTBOX MODERN -->
        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#2563EB"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- GAYA TOMBOL UTAMA -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBlue}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="{StaticResource PrimaryHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#1E40AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- GAYA TOMBOL OUTLINE -->
        <Style x:Key="OutlineButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#F1F5F9"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- GAYA TOMBOL AKSI TABEL (EDIT) -->
        <Style x:Key="TableEditBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#EFF6FF"/>
            <Setter Property="Foreground" Value="#2563EB"/>
            <Setter Property="BorderBrush" Value="#BFDBFE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2563EB"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- GAYA TOMBOL AKSI TABEL (HAPUS) -->
        <Style x:Key="TableDeleteBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#FEF2F2"/>
            <Setter Property="Foreground" Value="#EF4444"/>
            <Setter Property="BorderBrush" Value="#FECACA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#EF4444"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 1. HEADER -->
            <RowDefinition Height="Auto"/>
            <!-- 2. INFO PANEL / STATISTIK -->
            <RowDefinition Height="Auto"/>
            <!-- 3. KONTEN UTAMA (FORM & DATAGRID) -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ========================================================= -->
        <!-- 1. HEADER UTAMA APLIKASI                                  -->
        <!-- ========================================================= -->
        <Border Grid.Row="0" Background="{StaticResource DarkNavy}" Padding="24,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Icon & Brand Header -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="40" Height="40" Background="{StaticResource PrimaryBlue}" CornerRadius="8">
                        <TextBlock Text="🎓" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Sistem Manajemen Data Mahasiswa"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#FFFFFF"/>
                        <TextBlock Text="Aplikasi Desktop WPF dengan Arsitektur MVVM &amp; Akses Database ADO.NET"
                                   FontSize="12"
                                   Foreground="#94A3B8"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Badge Kanan -->
                <Border Grid.Column="2"
                        Background="#1E293B"
                        BorderBrush="#334155"
                        BorderThickness="1"
                        CornerRadius="20"
                        Padding="14,6"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessGreen}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Database SQLite Aktif" Foreground="#CBD5E1" FontSize="12" FontWeight="Medium"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ========================================================= -->
        <!-- 2. INFO PANEL (3 KARTU STATISTIK RINGKAS)                -->
        <!-- ========================================================= -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Card 1: Total Mahasiswa -->
                <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="TOTAL MAHASISWA" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                            <TextBlock Text="{Binding TotalMahasiswa}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource DarkNavy}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Width="40" Height="40" CornerRadius="8" Background="#EFF6FF" VerticalAlignment="Center">
                            <TextBlock Text="👥" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Card 2: Total Jurusan -->
                <Border Grid.Column="2" Background="#F8FAFC" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="PROGRAM STUDI AKTIF" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                            <TextBlock Text="{Binding TotalJurusan}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource DarkNavy}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Width="40" Height="40" CornerRadius="8" Background="#F0FDF4" VerticalAlignment="Center">
                            <TextBlock Text="📚" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Card 3: Jurusan Terbanyak -->
                <Border Grid.Column="4" Background="#F8FAFC" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="PROGRAM STUDI TERBANYAK" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                            <TextBlock Text="{Binding JurusanTerbanyak}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource DarkNavy}" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Border Grid.Column="1" Width="40" Height="40" CornerRadius="8" Background="#FEF3C7" VerticalAlignment="Center">
                            <TextBlock Text="🏆" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ========================================================= -->
        <!-- 3. KONTEN UTAMA: FORM INPUT (KIRI) & TABEL + SEARCH (KANAN) -->
        <!-- ========================================================= -->
        <Grid Grid.Row="2" Margin="24,20,24,20">
            <Grid.ColumnDefinitions>
                <!-- Kolom Kiri: Form Input Data & Edit -->
                <ColumnDefinition Width="380"/>
                <!-- Pemisah -->
                <ColumnDefinition Width="20"/>
                <!-- Kolom Kanan: Search & DataGrid -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ========================================== -->
            <!-- PANEL KIRI: FORM ENTRI & EDIT MAHASISWA    -->
            <!-- ========================================== -->
            <Border Grid.Column="0"
                    Background="{StaticResource CardBg}"
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="22">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!-- Header Form Dinamis (Tambah vs Edit) -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding FormTitle}"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource DarkNavy}"/>
                                <TextBlock Text="Isi rincian informasi data mahasiswa di bawah ini"
                                           FontSize="11.5"
                                           Foreground="{StaticResource TextMuted}"
                                           Margin="0,3,0,0"/>
                            </StackPanel>

                            <!-- Badge Indikator Mode Edit -->
                            <Border Grid.Column="1"
                                    Background="#FEF3C7"
                                    BorderBrush="#FCD34D"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="8,3"
                                    VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="✏️ Mode Edit" FontSize="11" FontWeight="Bold" Foreground="#B45309"/>
                            </Border>
                        </Grid>

                        <!-- Banner Notifikasi Pesan Status -->
                        <Border CornerRadius="6" Padding="12,10" Margin="0,0,0,14">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Setter Property="Background" Value="#DCFCE7"/>
                                    <Setter Property="BorderBrush" Value="#86EFAC"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasStatusMessage}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                            <Setter Property="Background" Value="#FEE2E2"/>
                                            <Setter Property="BorderBrush" Value="#FCA5A5"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding StatusMessage}"
                                       FontSize="12"
                                       FontWeight="Medium"
                                       TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#15803D"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                                <Setter Property="Foreground" Value="#B91C1C"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>

                        <!-- FIELD 1: NIM -->
                        <StackPanel Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                <TextBlock Text="Nomor Induk Mahasiswa (NIM)" FontWeight="SemiBold" FontSize="12.5"/>
                                <TextBlock Text=" *" Foreground="{StaticResource DangerRed}"/>
                            </StackPanel>
                            <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                     Text="{Binding CurrentStudent.Nim, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <!-- FIELD 2: NAMA LENGKAP -->
                        <StackPanel Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                <TextBlock Text="Nama Lengkap" FontWeight="SemiBold" FontSize="12.5"/>
                                <TextBlock Text=" *" Foreground="{StaticResource DangerRed}"/>
                            </StackPanel>
                            <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                     Text="{Binding CurrentStudent.Nama, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <!-- FIELD 3: PROGRAM STUDI / JURUSAN -->
                        <StackPanel Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                <TextBlock Text="Program Studi / Jurusan" FontWeight="SemiBold" FontSize="12.5"/>
                                <TextBlock Text=" *" Foreground="{StaticResource DangerRed}"/>
                            </StackPanel>
                            <ComboBox ItemsSource="{Binding JurusanList}"
                                      SelectedItem="{Binding CurrentStudent.Jurusan, Mode=TwoWay}"
                                      Padding="10,8"
                                      FontSize="13"/>
                        </StackPanel>

                        <!-- FIELD 4: EMAIL -->
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Email Kampus / Pribadi" FontWeight="SemiBold" FontSize="12.5" Margin="0,0,0,5"/>
                            <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                     Text="{Binding CurrentStudent.Email, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <!-- FIELD 5: NO TELEPON -->
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Nomor Telepon / WhatsApp" FontWeight="SemiBold" FontSize="12.5" Margin="0,0,0,5"/>
                            <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                     Text="{Binding CurrentStudent.NoHp, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <!-- FIELD 6: ALAMAT -->
                        <StackPanel Margin="0,0,0,18">
                            <TextBlock Text="Alamat Domisili" FontWeight="SemiBold" FontSize="12.5" Margin="0,0,0,5"/>
                            <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                     Height="65"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalContentAlignment="Top"
                                     Text="{Binding CurrentStudent.Alamat, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <!-- TOMBOL AKSI FORM (SIMPAN / PERBARUI & RESET / BATAL) -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="1.5*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Tombol Batal / Reset -->
                            <Button Grid.Column="0"
                                    Command="{Binding BatalEditCommand}"
                                    Style="{StaticResource OutlineButtonStyle}">
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="↺ Reset"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                                    <Setter Property="Text" Value="✕ Batal"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>

                            <!-- Tombol Simpan / Perbarui -->
                            <Button Grid.Column="2"
                                    Command="{Binding SimpanCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                        <Style.Triggers>
                                            <!-- Beri warna oranye saat mode update/edit -->
                                            <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                                <Setter Property="Background" Value="#F59E0B"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="💾 " VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding SaveButtonText}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ========================================== -->
            <!-- PANEL KANAN: PENCARIAN & TABEL DATA (CRUD) -->
            <!-- ========================================== -->
            <Border Grid.Column="2"
                    Background="{StaticResource CardBg}"
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Baris Search -->
                        <RowDefinition Height="Auto"/>
                        <!-- Baris DataGrid -->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- SEARCH BAR & KONTROL ATAS -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Label Data -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Daftar Data Mahasiswa" FontSize="16" FontWeight="Bold" Foreground="{StaticResource DarkNavy}"/>
                            <TextBlock Text="Klik tombol 'Edit' atau baris untuk mengubah data" FontSize="11.5" Foreground="{StaticResource TextMuted}"/>
                        </StackPanel>

                        <!-- Input Pencarian -->
                        <TextBox Grid.Column="1"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Ketik NIM, Nama, Jurusan, atau Alamat untuk mencari"/>

                        <!-- Tombol Cari -->
                        <Button Grid.Column="3"
                                Command="{Binding SearchCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Padding="14,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔍 Cari" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Tombol Reset Search -->
                        <Button Grid.Column="5"
                                Command="{Binding ResetSearchCommand}"
                                Style="{StaticResource OutlineButtonStyle}"
                                Padding="12,8"
                                Content="Reset"/>
                    </Grid>

                    <!-- TABEL DATAGRID MAHASISWA -->
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Students}"
                              SelectedItem="{Binding SelectedStudent, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E2E8F0"
                              RowBackground="#FFFFFF"
                              AlternatingRowBackground="#F8FAFC"
                              BorderBrush="{StaticResource BorderColor}"
                              BorderThickness="1"
                              HeadersVisibility="Column"
                              RowHeight="38"
                              FontSize="12.5">

                        <!-- HEADER STYLE -->
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F1F5F9"/>
                                <Setter Property="Foreground" Value="#475569"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Padding" Value="12,10"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="#CBD5E1"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.Columns>
                            <!-- Kolom 1: NIM -->
                            <DataGridTextColumn Header="NIM" Binding="{Binding Nim}" Width="105" FontWeight="SemiBold"/>

                            <!-- Kolom 2: Nama Lengkap -->
                            <DataGridTextColumn Header="Nama Mahasiswa" Binding="{Binding Nama}" Width="160"/>

                            <!-- Kolom 3: Jurusan -->
                            <DataGridTextColumn Header="Program Studi" Binding="{Binding Jurusan}" Width="140"/>

                            <!-- Kolom 4: No Telepon -->
                            <DataGridTextColumn Header="No. Telepon" Binding="{Binding NoHp}" Width="120"/>

                            <!-- Kolom 5: Email -->
                            <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="150"/>

                            <!-- Kolom 6: Alamat -->
                            <DataGridTextColumn Header="Alamat" Binding="{Binding Alamat}" Width="*"/>

                            <!-- Kolom 7: Tombol Aksi (EDIT & HAPUS) -->
                            <DataGridTemplateColumn Header="Aksi" Width="135">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type local:Student}">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <!-- TOMBOL EDIT DATA MAHASISWA -->
                                            <Button Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource TableEditBtnStyle}"
                                                    ToolTip="Edit data mahasiswa ini">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="✏️ Edit"/>
                                                </StackPanel>
                                            </Button>

                                            <!-- TOMBOL HAPUS DATA MAHASISWA -->
                                            <Button Command="{Binding DataContext.HapusCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource TableDeleteBtnStyle}"
                                                    ToolTip="Hapus data mahasiswa ini">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="🗑️ Hapus"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
